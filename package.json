{
  "name": "ai-voiceover-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade AI Voiceover SaaS Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start --filter=web",
    "db:push": "prisma db push --schema=packages/db/prisma/schema.prisma",
    "worker": "turbo run worker --filter=web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.24",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
