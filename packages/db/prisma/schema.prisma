datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionTier {
  FREE
  CREATOR
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum TransactionType {
  PURCHASE
  USAGE
  BONUS
  REFUND
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CollaborationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  passwordHash     String
  stripeCustomerId String?          @unique
  credits          Int              @default(1000)
  tier             SubscriptionTier @default(FREE)
  role             String           @default("USER") // "USER" | "ADMIN" | "SUPERADMIN"
  isSuspended      Boolean          @default(false)
  invitedBy        String?          // The invite code they used to sign up
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  subscriptions       Subscription[]
  creditTransactions  CreditTransaction[]
  voiceGenerations    VoiceGeneration[]
  clonedVoices        ClonedVoice[]
  collaborator        Collaborator?
  upgradeRequests     UpgradeRequest[]

  @@index([email])
  @@index([stripeCustomerId])
  @@index([role])
  @@index([isSuspended])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId   String             @unique
  stripePriceId          String
  stripeCurrentPeriodEnd DateTime
  status                 SubscriptionStatus
  planTier               SubscriptionTier
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model CreditTransaction {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  type            TransactionType
  description     String?
  stripeSessionId String?
  createdAt       DateTime        @default(now())

  @@index([userId])
  @@index([stripeSessionId])
}

model VoiceGeneration {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String           @db.Text
  voiceId      String
  status       GenerationStatus @default(PENDING)
  audioUrl     String?
  duration     Float?
  cost         Float?
  creditsUsed  Int
  jobId        String?
  errorMessage String?
  format       String           @default("mp3")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([jobId])
}

model ClonedVoice {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fishAudioId    String
  name           String
  gender         String   @default("neutral")
  language       String   @default("en-US")
  sampleAudioUrl String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([fishAudioId])
}

model PlatformVoice {
  id              String   @id @default(cuid())
  fishAudioId     String   @unique
  name            String
  gender          String   @default("neutral")
  category        String   @default("conversational")
  language        String   @default("en-US")
  languageName    String   @default("English (United States) 🇺🇸")
  tags            String[] @default([])
  previewAudioUrl String?
  avatarUrl       String?
  isPremium       Boolean  @default(true)
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fishAudioId])
  @@index([isActive])
}

model Collaborator {
  id               String               @id @default(cuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteCode       String               @unique
  socialLinks      String               @db.Text
  bankDetails      String               @db.Text
  status           CollaborationStatus  @default(PENDING)
  totalInvites     Int                  @default(0)
  totalEarnings    Float                @default(0)
  availableBalance Float                @default(0)
  
  payoutRequests   PayoutRequest[]
  earnings         CollaboratorEarning[]

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([inviteCode])
  @@index([status])
}

model CollaboratorEarning {
  id               String       @id @default(cuid())
  collaboratorId   String
  collaborator     Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  amount           Float
  description      String
  sourceUserId     String?      // The user who signed up / paid
  createdAt        DateTime     @default(now())

  @@index([collaboratorId])
  @@index([sourceUserId])
}

model PayoutRequest {
  id               String       @id @default(cuid())
  collaboratorId   String
  collaborator     Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  amount           Float
  status           PayoutStatus @default(PENDING)
  bankDetails      String       @db.Text
  adminNotes       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([collaboratorId])
  @@index([status])
}

model UpgradeRequest {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  planName    String
  planPrice   String
  status      UpgradeRequestStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}
