datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionTier {
  FREE
  CREATOR
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum TransactionType {
  PURCHASE
  USAGE
  BONUS
  REFUND
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  passwordHash     String
  stripeCustomerId String?          @unique
  credits          Int              @default(1000)
  tier             SubscriptionTier @default(FREE)
  role             String           @default("USER") // "USER" | "ADMIN" | "SUPERADMIN"
  isSuspended      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  subscriptions       Subscription[]
  creditTransactions  CreditTransaction[]
  voiceGenerations    VoiceGeneration[]
  clonedVoices        ClonedVoice[]

  @@index([email])
  @@index([stripeCustomerId])
  @@index([role])
  @@index([isSuspended])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId   String             @unique
  stripePriceId          String
  stripeCurrentPeriodEnd DateTime
  status                 SubscriptionStatus
  planTier               SubscriptionTier
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model CreditTransaction {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  type            TransactionType
  description     String?
  stripeSessionId String?
  createdAt       DateTime        @default(now())

  @@index([userId])
  @@index([stripeSessionId])
}

model VoiceGeneration {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String           @db.Text
  voiceId      String
  status       GenerationStatus @default(PENDING)
  audioUrl     String?
  duration     Float?
  cost         Float?
  creditsUsed  Int
  jobId        String?
  errorMessage String?
  format       String           @default("mp3")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([jobId])
}

model ClonedVoice {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fishAudioId    String
  name           String
  gender         String   @default("neutral")
  language       String   @default("en-US")
  sampleAudioUrl String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([fishAudioId])
}

model PlatformVoice {
  id              String   @id @default(cuid())
  fishAudioId     String   @unique
  name            String
  gender          String   @default("neutral")
  category        String   @default("conversational")
  language        String   @default("en-US")
  languageName    String   @default("English (United States) 🇺🇸")
  tags            String[] @default([])
  previewAudioUrl String?
  avatarUrl       String?
  isPremium       Boolean  @default(true)
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fishAudioId])
  @@index([isActive])
}
